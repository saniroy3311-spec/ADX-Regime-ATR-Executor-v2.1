[Unit]
Description=ADX Regime ATR Executor — EMA 20/50
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/adx-regime-atr-executor
EnvironmentFile=/opt/adx-regime-atr-executor/.env
ExecStart=/opt/adx-regime-atr-executor/.venv/bin/python /opt/adx-regime-atr-executor/main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=adx-regime-atr-executor
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
