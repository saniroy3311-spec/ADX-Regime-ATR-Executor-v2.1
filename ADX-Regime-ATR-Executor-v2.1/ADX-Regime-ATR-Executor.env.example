# ================================================================
# ADX Regime ATR Executor — canonical environment file
# Strategy source of truth: ADX Regime ATR Execution Engine v2.1, active EMA Fast 20 / Trend 50 profile
# ================================================================
BOT_NAME=ADX Regime ATR Executor
BOT_VERSION=2.1.0-parity
PINE_PARITY_MODE=true
LIVE_TICK_RISK_ENGINE=true
TRAIL_STAGE_UPDATE_MODE=tick
BREAKEVEN_UPDATE_MODE=tick
MAX_SL_EVAL_MODE=tick

# -------- Execution mode --------
# paper = live prices/account endpoint but NO exchange orders are sent.
# live  = sends real/testnet orders. Production also requires LIVE_TRADING_ENABLED=true.
EXECUTION_MODE=paper
LIVE_TRADING_ENABLED=false
STRICT_MARKET_METADATA=true

# -------- Delta Exchange India --------
# To paper-trade against the LIVE market/account: DELTA_TESTNET=false + EXECUTION_MODE=paper.
# To place REAL production orders: DELTA_TESTNET=false + EXECUTION_MODE=live + LIVE_TRADING_ENABLED=true.
DELTA_API_KEY=YOUR_DELTA_API_KEY
DELTA_API_SECRET=YOUR_DELTA_API_SECRET
DELTA_TESTNET=true
SYMBOL=BTC/USD:USD
DELTA_PRODUCT_SYMBOL=BTCUSD
DELTA_CONTRACT_VALUE=0.001
ALERT_QTY=100

# -------- Pine / chart model --------
CANDLE_TIMEFRAME=30m
EMA_FAST_LEN=20
EMA_TREND_LEN=50
PINE_MINTICK=0.5
PINE_SLIPPAGE_TICKS=2
PINE_POINT_VALUE=1.0
PINE_ORDER_QTY=0.1

# IMPORTANT: signal candles must be from the same exchange/symbol as TradingView.
# false = Delta candle feed (recommended default for BTCUSD.P)
# true  = Binance BTC/USDT candles; if used, verify PINE_MINTICK (often 0.1).
BINANCE_SIGNAL_FEED=false
BINANCE_SYMBOL=BTC/USDT

# -------- Exact ADX Regime ATR Execution Engine v2.1 parameters --------
ATR_LEN=14
DI_LEN=14
ADX_SMOOTH=14
ADX_EMA=5
RSI_LEN=14
ADX_TREND_TH=22
ADX_RANGE_TH=18
ADX_TOLERANCE=0
FILTER_ATR_MULT=1.4
FILTER_BODY_MULT=0.5
FILTER_BODY_TOLERANCE=0
FILTER_VOL_ENABLED=true
FILTER_VOL_MULT=1.0
BREAKOUT_BUFFER_PTS=0
RSI_OB=70
RSI_OS=30
TREND_RR=4.0
RANGE_RR=2.5
TREND_ATR_MULT=0.6
RANGE_ATR_MULT=0.5
MAX_SL_MULT=1.5
MAX_SL_POINTS=500
BE_MULT=0.6
TRAIL1_TRIGGER=0.8
TRAIL1_PTS=0.50
TRAIL1_OFF=0.40
TRAIL2_TRIGGER=1.5
TRAIL2_PTS=0.40
TRAIL2_OFF=0.30
TRAIL3_TRIGGER=2.5
TRAIL3_PTS=0.30
TRAIL3_OFF=0.25
TRAIL4_TRIGGER=4.0
TRAIL4_PTS=0.20
TRAIL4_OFF=0.15
TRAIL5_TRIGGER=6.0
TRAIL5_PTS=0.15
TRAIL5_OFF=0.10
COMMISSION_PCT=0.05
DELTA_GST_RATE=0.18
FEE_MODEL_INCLUDE_GST=true

# -------- Strict parity execution switches --------
TP_HARD_EXIT=true
BAR_CLOSE_SL_EVAL=false
TIME_EXIT_MINUTES=0
TRAIL_SL_PRE_FIRE_BUFFER=0
TRAIL_OFFSET_FLOOR_MULT=0
TRAIL_ARM_FLOOR_MULT=0
SL_CONFIRM_MS=0
SL_CONFIRM_TICKS=1
TRAIL_SL_CONFIRM_TICKS=1
TRAIL_EXIT_FROM_DELTA_WS=true
TRAIL_FIRE_SL_ON_CANDLE_EXTREME=false

# Exchange-side initial SL+TP bracket; Python owns dynamic trail/BE exits.
EMERGENCY_BRACKET_ENABLED=true
BRACKET_SL_WIDEN_MULT=1.0
BRACKET_SL_MIN_PTS=0
BRACKET_SL_BUFFER=0
SL_FIRE_VIA_BRACKET=false
MAX_EXIT_SLIPPAGE_ATR_PCT=25
TRAIL_LOOP_SEC=0.25
WS_RECONNECT_SEC=5
MAX_ENTRY_SLIP_ATR_FRAC=0.30

# -------- Telegram (optional) --------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# -------- WhatsApp (optional) --------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# -------- Dashboard --------
DASHBOARD_USER=admin
DASHBOARD_PASS=CHANGE_THIS_PASSWORD
CLIENT_DASHBOARD_PORT=8081

# -------- Storage --------
LOG_FILE=./data/adx_regime_atr_executor.db
TURSO_URL=
TURSO_TOKEN=
GSHEET_ENABLED=false
GSHEET_AUTO_CREATE=true
GSHEET_SPREADSHEET_ID=YOUR_GOOGLE_SHEET_ID
# Recommended: put the downloaded Google service-account key beside the bot
# (or use an absolute path) and keep it out of git.
GSHEET_CREDENTIALS_FILE=./secrets/google-service-account.json
# Alternative to the file path above: one-line service-account JSON. Leave blank if using file.
GSHEET_CREDENTIALS_JSON=
